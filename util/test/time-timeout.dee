import * from deemon;
import * from time;

/* Make sure that `Time` can be used in APIs that use `__timeout_nanoseconds__`,
 * and that it returns the correct values when queried in this manner. */

function verifyTimeout(gen: Callable with int, multiplier: int) {
	assert gen(0).__timeout_nanoseconds__ == 0 * multiplier;
	assert gen(1).__timeout_nanoseconds__ == 1 * multiplier;
	assert gen(999).__timeout_nanoseconds__ == 999 * multiplier;
}

verifyTimeout(nanoseconds,  multiplier: 1);
verifyTimeout(microseconds, multiplier: 1_000);
verifyTimeout(milliseconds, multiplier: 1_000_000);
verifyTimeout(seconds,      multiplier: 1_000_000_000);
verifyTimeout(minutes,      multiplier: 60_000_000_000);
verifyTimeout(hours,        multiplier: 3_600_000_000_000);
verifyTimeout(days,         multiplier: 86_400_000_000_000);
verifyTimeout(weeks,        multiplier: 604_800_000_000_000);
verifyTimeout(months,       multiplier: 2_629_746_000_000_000);
verifyTimeout(years,        multiplier: 31_556_952_000_000_000);
verifyTimeout(decades,      multiplier: 315_569_520_000_000_000);
verifyTimeout(centuries,    multiplier: 3_155_695_200_000_000_000);
verifyTimeout(millennia,    multiplier: 31_556_952_000_000_000_000);
