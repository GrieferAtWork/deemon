WARNING_NAMESPACE(WN_QUALITY, 2250)
DEF_WARNING(W_UNCLEAR_CAST_INTENT, (WG_QUALITY), WSTATE_DISABLED, /* Leave this warning disabled; too many false positives. */
            WARNF("Intended code behavior of potential cast expression is ambiguous and not compiled as a cast. "
                  "To suppress this warning, add a second pair of parenthesis to the previous expression"))
DEF_WARNING(W_PROBABLY_MISSING_ARROW, (WG_QUALITY), WSTATE_WARN,
            WARNF("Encountered `{` after parenthesis (`(...) {`). This will compile as `Tuple({...})({ ...`, "
                  "which probably isn't what you want. Insert `->` if this is meant to be a lambda, or write "
                  "`(...)({ ... })` if you really want to call a tuple and get the resulting NotImplemented error"))
DEF_WARNING(W_UNCLEAR_SYMBOL_FROM_MODULE, (WG_QUALITY), WSTATE_WARN, {
	char const *sym = ARG(char const *);
	char const *mod = ARG(char const *);
	WARNF("Consider writing `(%s from %s)` to prevent confusion on where the module name ends", sym, mod);
})
DEF_WARNING(W_PACK_USED_OUTSIDE_OF_MACRO, (WG_QUALITY), WSTATE_WARN,
            WARNF("Using `pack` outside of macros makes code harder to read. Consider using parenthesis instead"))
DEF_WARNING(W_INCONSISTENT_THOUSANDS_SEPERATORS, (WG_QUALITY), WSTATE_WARN, {
	unsigned int s1 = ARG(unsigned int);
	unsigned int s2 = ARG(unsigned int);
	WARNF("Thousands/grouping character `_` is used inconsistently in " TOK_S ": "
	      "groupings of width %u and %u are present",
	      TOK_A, s1, s2);
})
DEF_WARNING(W_INCORRECT_THOUSANDS_SEPERATORS, (WG_QUALITY), WSTATE_WARN, {
	unsigned int expected = ARG(unsigned int);
	unsigned int actual   = ARG(unsigned int);
	WARNF("Thousands/grouping character `_` is used incorrectly in " TOK_S ": "
	      "a separator should appear every %u digits, but actually appears every %u digits",
	      TOK_A, expected, actual);
})



