TPP_WARNING(TPP_W_EXPECTED_VARIABLE_AFTER_VISIBILITY, 1(TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Expected variable name after %[global%] or %[local%], but got %Pt")
