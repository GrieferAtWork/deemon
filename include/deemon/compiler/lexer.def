#ifdef CONFIG_EXPERIMENTAL_USE_TPP3

/* Define a keyword and mark it as an identifier */
#define DEE_KWD_IDENTIFIER(id, str) \
	TPP_KWD(id, str)                \
	TPP_KWD_IS_IDENTIFIER(id, true)

TPP_KWD(TPP_KWD_, "") /* Special case for *empty* keyword */

/* Unary expression keywords. */
DEE_KWD_IDENTIFIER(TPP_KWD_none, "none")
DEE_KWD_IDENTIFIER(TPP_KWD_true, "true")
DEE_KWD_IDENTIFIER(TPP_KWD_false, "false")
DEE_KWD_IDENTIFIER(TPP_KWD_copy, "copy")
DEE_KWD_IDENTIFIER(TPP_KWD_deepcopy, "deepcopy")
#ifndef TPP_KWD_assert
DEE_KWD_IDENTIFIER(TPP_KWD_assert, "assert")
#endif /* !TPP_KWD_assert */
#ifndef TPP_KWD_import
DEE_KWD_IDENTIFIER(TPP_KWD_import, "import")
#endif /* !TPP_KWD_import */
DEE_KWD_IDENTIFIER(TPP_KWD_str, "str")
DEE_KWD_IDENTIFIER(TPP_KWD_repr, "repr")
DEE_KWD_IDENTIFIER(TPP_KWD_type, "type")
DEE_KWD_IDENTIFIER(TPP_KWD_function, "function")
DEE_KWD_IDENTIFIER(TPP_KWD_with, "with")
DEE_KWD_IDENTIFIER(TPP_KWD_pack, "pack")
#ifndef TPP_KWD_if
DEE_KWD_IDENTIFIER(TPP_KWD_if, "if")
#endif /* !TPP_KWD_if */
#ifndef TPP_KWD_else
DEE_KWD_IDENTIFIER(TPP_KWD_else, "else")
#endif /* !TPP_KWD_else */
#ifndef TPP_KWD_elif
DEE_KWD_IDENTIFIER(TPP_KWD_elif, "elif")
#endif /* !TPP_KWD_elif */
DEE_KWD_IDENTIFIER(TPP_KWD_do, "do")
DEE_KWD_IDENTIFIER(TPP_KWD_while, "while")
DEE_KWD_IDENTIFIER(TPP_KWD_for, "for")
DEE_KWD_IDENTIFIER(TPP_KWD_foreach, "foreach")
DEE_KWD_IDENTIFIER(TPP_KWD___nth, "__nth")
DEE_KWD_IDENTIFIER(TPP_KWD_operator, "operator")
#define TPP_KWD_ISUNARY(x) \
	((x) >= TPP_KWD_none && (x) <= TPP_KWD_operator)

DEE_KWD_IDENTIFIER(TPP_KWD_final, "final")
DEE_KWD_IDENTIFIER(TPP_KWD_varying, "varying")
DEE_KWD_IDENTIFIER(TPP_KWD_class, "class")
DEE_KWD_IDENTIFIER(TPP_KWD_this, "this")
DEE_KWD_IDENTIFIER(TPP_KWD_super, "super")
DEE_KWD_IDENTIFIER(TPP_KWD_is, "is")
DEE_KWD_IDENTIFIER(TPP_KWD_in, "in")

/* New keyword: Create a super-wrapper: `<expression> as <type>` */
DEE_KWD_IDENTIFIER(TPP_KWD_as, "as")

/* New keyword: Check if a symbol is bound: `local x; if (bound(x)) { ... }`
 * This function-like builtin keyword can be used to determine if a
 * local, global, or external variable is currently bound, as well as
 * if an object implements a specific attribute:
 * >> if (bound(foo)) { // Check if a symbol `foo` is currently bound.
 * >>     // `(boundattr from deemon)(foo, "attribute_name")'
 * >>     if (bound(foo.attribute_name)) {
 * >>     }
 * >> }
 *
 * An alternate way of writing a bound-expression is:
 * >> if (foo is bound) {
 * >>     if (foo.attribute_name is bound) {
 * >>     }
 * >> }
 */
DEE_KWD_IDENTIFIER(TPP_KWD_bound, "bound")

/* Statement keywords. */
DEE_KWD_IDENTIFIER(TPP_KWD_from, "from")
DEE_KWD_IDENTIFIER(TPP_KWD_break, "break") /* WARNING: Next token must be `continue` (keep these together) */
DEE_KWD_IDENTIFIER(TPP_KWD_continue, "continue")
DEE_KWD_IDENTIFIER(TPP_KWD_return, "return")
DEE_KWD_IDENTIFIER(TPP_KWD_yield, "yield")
DEE_KWD_IDENTIFIER(TPP_KWD_throw, "throw")
DEE_KWD_IDENTIFIER(TPP_KWD_try, "try")
DEE_KWD_IDENTIFIER(TPP_KWD_finally, "finally")
DEE_KWD_IDENTIFIER(TPP_KWD_catch, "catch")
DEE_KWD_IDENTIFIER(TPP_KWD_del, "del")
DEE_KWD_IDENTIFIER(TPP_KWD_print, "print")
DEE_KWD_IDENTIFIER(TPP_KWD___asm, "__asm")
DEE_KWD_IDENTIFIER(TPP_KWD___asm__, "__asm__")
DEE_KWD_IDENTIFIER(TPP_KWD_goto, "goto")
DEE_KWD_IDENTIFIER(TPP_KWD_switch, "switch")
DEE_KWD_IDENTIFIER(TPP_KWD_case, "case")
#ifndef TPP_KWD_default
DEE_KWD_IDENTIFIER(TPP_KWD_default, "default")
#endif /* !TPP_KWD_default */

/* Class scope & related keywords. */
DEE_KWD_IDENTIFIER(TPP_KWD_private, "private")
DEE_KWD_IDENTIFIER(TPP_KWD_public, "public")
DEE_KWD_IDENTIFIER(TPP_KWD_property, "property")
DEE_KWD_IDENTIFIER(TPP_KWD_member, "member")


/* Variable scope modifiers.
 * The rules on where these may appear have been greatly restricted since
 * v200, now only being allowed in variable declarations/store expressions:
 * >> local x;          // Ok (forward declaration / unbound variable)
 * >> local x = 42;     // Ok
 * >> local x, local y; // ERROR (Only warned about before)
 * >> print local x;    // ERROR (But used to be ok before)
 * >> local x += 11;    // ERROR (But used to be ok before)
 * >> print x;          // This is the only valid way of writing it now.
 * >> x += 37;          // Ok.
 * The same goes for use of `global` which now defines
 * variables that should be exported by the module.
 * Such variables must either be forward-declared in the
 * root scope of a module, and when appearing locally,
 * must always refer to an existing global variable:
 * >> global x; // define or reference an unbound, global variable `x`.
 * >>           // NOTE: If another inline-imported module already defined a variable `x`,
 * >>           //       that variable is referenced instead, meaning that `global` is not
 * >>           //       only used to reference global, but also extern variables.
 * >> x;        // Same as `global x`, but warned due to missing visibility constraint.
 * >>
 * >> function set_x() {
 * >>     x = 42;        // Ok
 * >>     global x = 42; // Ok (Does the same)
 * >>     local x = 10;  // this is a different "x"
 * >> }
 * >>
 * >> local y;  // Define a local variable not exported by the module.
 * >>           // Note that this variable cannot be used as an l-value in sub-functions,
 * >>           // as it a global variable, but instead private to the global scope of
 * >>           // the current module.
 * >>           // You can think of local variables in the global scope as private objects
 * >>           // that are not exported when another module uses `import` on use this one,
 * >>           // whilst regular global variables (without a storage prefix) are exported
 * >>           // and therewith visible to, as well as addressable and modifiable by other modules.
 * >> function set_local_y() {
 * >>     y = 42;        // Error: Cannot write to referenced variable (`y` isn't a global)
 * >>     global y = 42; // Same error: `global y` refers to a variable in
 * >>                    // the root scope, not an actual `global` variable.
 * >> }
 * >>
 *
 * Note however that `__nth()` still behaves like it
 * used to, though `__scope()` has also been removed:
 * >> local x = 20;
 * >> {
 * >>     local x = 10;
 * >>     print __nth(1) x; // 10
 * >>     print __nth(2) x; // 20
 * >> }
 */
DEE_KWD_IDENTIFIER(TPP_KWD_local, "local")
DEE_KWD_IDENTIFIER(TPP_KWD_global, "global")
DEE_KWD_IDENTIFIER(TPP_KWD_static, "static")
DEE_KWD_IDENTIFIER(TPP_KWD___stack, "__stack")

#define TPP_KWD_IS_D100_VARIABLE_MODIFIER(x) \
	((x) >= TPP_KWD_local && (x) <= TPP_KWD___stack)


/* Old-style classes simply means that any class without an explicitly
 * defined base will be derived from `OldUserClass from d200`, instead
 * of `object from deemon`, where `OldUserClass` overrides the attribute
 * operators to emulate a dynamic member table, as expected by old-style
 * code. */
TPP_EXTENSION(TPP_EXT_OLD_STYLE_CLASSES, "old-style-classes", 0)

/* Indicate to user-code that they are running under deemon v200 */
TPP_KWD(TPP_KWD___DEEMON__, "__DEEMON__")
TPP_MACRO(TPP_KWD___DEEMON__, 1)
TPP_PREDEFINED_MACRO(TPP_KWD___DEEMON__, "200")
TPP_KWD(TPP_KWD___DEEMON_VARIANT__, "__DEEMON_VARIANT__")
TPP_MACRO(TPP_KWD___DEEMON_VARIANT__, 1)
TPP_PREDEFINED_MACRO(TPP_KWD___DEEMON_VARIANT__, "\"gatw\"")


/* These are actually kind-of useful to determine the host platform in user-code.
 * Therefor I'll keep them as they were in the old deemon.
 * However, you _really_ shouldn't use them because they will confuse deemon
 * when you move your code between platforms without deleting the `.*.dec` files. */
#ifdef CONFIG_HOST_WINDOWS
TPP_KWD(TPP_KWD___WINDOWS__, "__WINDOWS__")
TPP_MACRO(TPP_KWD___WINDOWS__, 1)
TPP_PREDEFINED_MACRO(TPP_KWD___WINDOWS__, "1")
#endif /* CONFIG_HOST_WINDOWS */

#ifdef CONFIG_HOST_UNIX
TPP_KWD(TPP_KWD___unix__, "__unix__")
TPP_MACRO(TPP_KWD___unix__, 1)
TPP_PREDEFINED_MACRO(TPP_KWD___unix__, "1")

TPP_KWD(TPP_KWD___POSIX__, "__POSIX__") /* DEPRECATED! */
TPP_MACRO(TPP_KWD___POSIX__, 1)
TPP_PREDEFINED_MACRO(TPP_KWD___POSIX__, "1")
#endif /* CONFIG_HOST_UNIX */

#undef DEE_KWD_IDENTIFIER

TPP_WGROUP(TPP_WG_SYMBOL, 1("symbol"), TPP_WSTATE_ERROR)
TPP_WGROUP(TPP_WG_IMPLICIT, 1("implicit"), TPP_WSTATE_ERROR)
TPP_WGROUP(TPP_WG_READONLY, 1("readonly"), TPP_WSTATE_ERROR)
TPP_WGROUP(TPP_WG_RESERVED, 1("reserved"), TPP_WSTATE_ERROR)
TPP_WGROUP(TPP_WG_CONST, 1("const"), TPP_WSTATE_ERROR)
TPP_WGROUP(TPP_WG_D200, 1("d200"), TPP_WSTATE_ERROR)
TPP_WGROUP(TPP_WG_UNUSED_LABEL, 1("unused-label"), TPP_WSTATE_ERROR)
TPP_WGROUP(TPP_WG_VALUE, 1("value"), TPP_WSTATE_ERROR)

/* Syntax */
TPP_WARNING(TPP_W_DEPRECATED_CELL_SYNTAX, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Using %[<...>%] for constructing cells is deprecated. Use %[(Cell from deemon)(...)%] instead")
TPP_WARNING(TPP_W_DEPRECATED_ATTRIBUTE_SYNTAX, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Using %[::%] to lookup attributes is deprecated. Use %[.%] instead")
TPP_WARNING(TPP_W_DEPRECATED_GLOBAL_PREFIX, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Using %[::%] as global prefix is deprecated. Remove the prefix and rename other variables with the same name, or use %[__nth%]")
TPP_WARNING(TPP_W_DEPRECATED_PREFIX_IN_EXPRESSION, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Lookup modifiers other than %[__nth%] in expressions are no longer allowed since deemon 200")
TPP_WARNING(TPP_W_DEPRECATED_NO_PARAMETER_LIST, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "A missing parameter list in a function declaration is deprecated since deemon 200 for non-lambda-functions. Add an empty one by inserting %[()%]")
TPP_WARNING(TPP_W_DEPRECATED_CHARACTER_INT, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Writing integers as characters is deprecated since deemon 200. Consider writing %[%Pt.ord()%] instead") /* FIXME: "%Pt" already opens a quote-block, so this does a double-open! */
TPP_WARNING(TPP_W_DEPRECATED_ARROW_IN_CATCH_EXPRESSION, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Using %[->%] to assign an exception symbol is deprecated since deemon 200. Consider using %[as%] instead")
TPP_WARNING(TPP_W_DEPRECATED_FUNCTION_IN_EXPRESSION, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Using %[function%] to define lambdas in expressions is deprecated. Consider using %[() ->%] instead")
TPP_WARNING(TPP_W_DEPRECATED_LOOKUP_MODE_AFTER_VAR_TYPE, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Lookup mode modifier after C-like declaration type is deprecated since deemon 200. Consider moving the modifier before the type expression, or removing the modifier to have the variable always be declared as %[local%]")
TPP_WARNING(TPP_W_DEPRECATED_CLASS_BASE_EXTENDS, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Using %[MyClass extends Super%] to specify class base is deprecated. Use %[MyClass: Super%] instead")
TPP_WARNING(TPP_W_DEPRECATED_CLASS_BASE_PARENS, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_WARN, "Using %[MyClass(Super)%] to specify class base is deprecated. Use %[MyClass: Super%] instead")

TPP_WARNING(TPP_W_EXPECTED_DOTS_KEYWORD_OR_STRING_IN_IMPORT_LIST, 1(TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Expected %[.%], a keyword or a string in a module- or symbol-import list, but got %Pt")
TPP_WARNING(TPP_W_EXPECTED_KEYWORD_OR_STRING_IN_IMPORT_LIST, 1(TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Expected a keyword or a string in a symbol-import list, but got %Pt")
TPP_WARNING(TPP_W_EXPECTED_KEYWORD_AFTER_AS, 1(TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Expected a keyword after %[as%] in a module- or symbol-import list, but got %Pt")
//Unused:TPP_WARNING(TPP_W_EXPECTED_IMPORT_AFTER_FROM, 1(TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Expected %[import%] after %[from%], but got %Pt")
TPP_WARNING(TPP_W_EXPECTED_COMMA_OR_FROM_AFTER_START_IN_IMPORT_LIST, 1(TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Expected %[,%] or %[from%] after %[*%] in symbol import list, but got %Pt")
TPP_WARNING(TPP_W_EXPECTED_FROM_AFTER_SYMBOL_IMPORT_LIST, 1(TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Expected %[from%] after symbol import list, but got %Pt")
TPP_WARNING(TPP_W_UNEXPECTED_STAR_DUPLICATION_IN_IMPORT_LIST, 1(TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Unexpected %[*%] in import list, when %[*%] had already been encountered before")
TPP_WARNING(TPP_W_UNEXPECTED_FROM_AFTER_MODULE_IMPORT_LIST, 1(TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Unexpected %[from%] following a module import list")
