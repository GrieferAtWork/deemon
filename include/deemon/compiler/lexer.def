TPP_WARNING(TPP_W_DECLARING_GLOBAL_IN_NONROOT, 1(TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, "Declaring global variable %[%s%] outside of the root scope")
TPP_WARNING_EX(TPP_W_DECLARING_IMPLICIT_VARIABLE, 2(TPP_WG_IMPLICIT, TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, {
	char const *varname = tpp_current_va_arg(char const *);
	tpp_warn_printf2(tpp_current_info(), "Implicitly declaring %Pt as a local variable. Write %[local %s%] if this is intended", varname, varname);
})
TPP_WARNING(TPP_W_INVALID_NAME_FOR_MODULE_SYMBOL, 1(TPP_WG_SYMBOL), 0(), TPP_WSTATE_ERROR, "Cannot import module %[%s%]: %[%s%] is not a valid variable name")
TPP_WARNING(TPP_W_INVALID_NAME_FOR_IMPORT_SYMBOL, 1(TPP_WG_SYMBOL), 0(), TPP_WSTATE_ERROR, "Cannot import symbol %[%s%]: %[%s%] is not a valid variable name")
TPP_WARNING(TPP_W_IMPORT_ALIAS_IS_ALREADY_DEFINED, 1(TPP_WG_SYMBOL), 0(), TPP_WSTATE_ERROR, "A symbol with the imported name %[%s%] has already been defined")
TPP_WARNING(TPP_W_IMPORT_GLOBAL_FROM_OWN_MODULE, 1(TPP_WG_SYMBOL), 0(), TPP_WSTATE_ERROR, "You can't import globals from your own module")
TPP_WARNING(TPP_W_MODULE_IMPORT_NOT_FOUND, 1(TPP_WG_SYMBOL), 0(), TPP_WSTATE_ERROR, "Symbol %[%s%] could not be found in module %[%s%]")
TPP_WARNING(TPP_W_RESERVED_IDENTIFIER_IN_ALIAS_NAME, 2(TPP_WG_RESERVED, TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, "A reserved identifier appears as alias for an import. Consider changing the offending alias %[%s%] to something different")
TPP_WARNING(TPP_W_RESERVED_IDENTIFIER_IN_MODULE_NAME, 2(TPP_WG_RESERVED, TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, "A reserved identifier appears in a module name. Consider writing the offending portion as a string %[\"%s\"%] instead")
TPP_WARNING_EX(TPP_W_RESERVED_IDENTIFIER_IN_MODULE_NAME_NOALIAS, 2(TPP_WG_RESERVED, TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, {
	char const *varname = tpp_current_va_arg(char const *);
	tpp_warn_printf2(tpp_current_info(), "A reserved identifier appears in a module name. Consider renaming the offending import to %[my_name_for_%s = \"%s\"%] instead", varname, varname);
})
TPP_WARNING(TPP_W_RESERVED_IDENTIFIER_IN_SYMBOL_NAME, 2(TPP_WG_RESERVED, TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, "A reserved identifier appears in a symbol name. Consider writing the offending portion as a string %[\"%s\"%] instead")
TPP_WARNING_EX(TPP_W_RESERVED_IDENTIFIER_IN_SYMBOL_NAME_NOALIAS, 2(TPP_WG_RESERVED, TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, {
	char const *varname = tpp_current_va_arg(char const *);
	tpp_warn_printf2(tpp_current_info(), "A reserved identifier appears in a symbol name. Consider renaming the offending import to %[my_name_for_%s = \"%s\"%] instead", varname, varname);
})
TPP_WARNING_EX(TPP_W_RESERVED_IDENTIFIER_IN_SYMBOL_OR_MODULE_NAME, 2(TPP_WG_RESERVED, TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, {
	char const *varname = tpp_current_va_arg(char const *);
	tpp_warn_printf2(tpp_current_info(), "A reserved identifier appears in a symbol or module name. Consider renaming the offending import as %[my_name_for_%s = \"%s\"%] instead", varname, varname);
})
TPP_WARNING_EX(TPP_W_RESERVED_IDENTIFIER_IN_AUTOGENERATED_SYMBOL_NAME, 2(TPP_WG_RESERVED, TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, {
	char const *varname = tpp_current_va_arg(char const *);
	tpp_warn_printf2(tpp_current_info(), "A reserved identifier was produced by the autogenerated name of a symbol import. Consider using an import alias %[my_name_for_%s = \"%s\"%] instead", varname, varname);
})
TPP_WARNING_EX(TPP_W_RESERVED_IDENTIFIER_IN_AUTOGENERATED_SYMBOL_OR_MODULE_NAME, 2(TPP_WG_RESERVED, TPP_WG_SYMBOL), 0(), TPP_WSTATE_WARN, {
	char const *varname = tpp_current_va_arg(char const *);
	tpp_warn_printf2(tpp_current_info(), "A reserved identifier was produced by the autogenerated name of a symbol or module import. Consider using an import alias %[my_name_for_%s = \"%s\"%] instead", varname, varname);
})

