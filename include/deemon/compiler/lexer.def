TPP_WARNING(TPP_W_EXPECTED_CONSTANT_AFTER_NTH, 2(TPP_WG_CONST, TPP_WG_VALUE), 0(), TPP_WSTATE_ERROR, "Expected a constant expression as argument for %[__nth%]")
TPP_WARNING(TPP_W_DEPRECATED_LAMBDA_MODE, 2(TPP_WG_D200, TPP_WG_SYNTAX), 0(), TPP_WSTATE_ERROR, "Specifying %[=%] or %[&%] within lambda brackets is deprecated. Consider removing the modifer, which has historically always been a no-op")
